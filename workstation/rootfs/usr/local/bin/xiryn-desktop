#!/bin/bash
# Boots the agent's desktop and keeps the container alive while it's in use.
#
# Xvfb draws the screen, xfwm4 and xfce4-panel make it a desktop, x11vnc
# serves it (password protected) and websockify/noVNC put it on port 6080.
# The container stops itself after XIRYN_IDLE_MINUTES without activity, so an
# idle agent costs nothing even when Xiryn isn't running to stop it.

set -u

state=/tmp/xiryn
mkdir -p "$state"

# A machine that was stopped keeps its /tmp. Locks left by the last run's X
# server would make this one refuse to start, so clear them: nothing is
# running yet.
display_number="${DISPLAY#:}"
rm -f "/tmp/.X${display_number}-lock" "/tmp/.X11-unix/X${display_number}"
touch "$state/active"
echo "${XIRYN_IDLE_MINUTES:-15}" > "$state/idle-minutes"

Xvfb "$DISPLAY" -screen 0 "${XIRYN_SCREEN:-1280x800}x24" -dpi 96 -nolisten tcp \
  >"$state/xvfb.log" 2>&1 &
xvfb=$!
for _ in $(seq 100); do
  xdpyinfo >/dev/null 2>&1 && break
  sleep 0.1
done

x11vnc -storepasswd "${XIRYN_VNC_PASSWORD:?XIRYN_VNC_PASSWORD is required}" \
  "$state/vncpass" >/dev/null 2>&1
unset XIRYN_VNC_PASSWORD
# Kept to put the file back if something clears /tmp: x11vnc reads it for
# every connection
vncpass=$(base64 -w0 "$state/vncpass")

eval "$(dbus-launch --sh-syntax)"
xfsettingsd --daemon >/dev/null 2>&1
xfwm4 --compositor=off >"$state/xfwm4.log" 2>&1 &
xfce4-panel >"$state/panel.log" 2>&1 &
feh --no-fehbg --bg-fill /usr/share/xiryn/wallpaper.png 2>/dev/null \
  || xsetroot -solid "#0b0e14"

# Not -localhost: a phone take-over's relay (a separate container Xiryn
# starts, see getTakeoverLink) connects here directly. Still password only.
x11vnc -display "$DISPLAY" -rfbauth "$state/vncpass" -rfbport 5900 \
  -forever -shared -noxdamage -quiet >"$state/x11vnc.log" 2>&1 &
vnc=$!
websockify --web /usr/share/novnc 6080 localhost:5900 >"$state/websockify.log" 2>&1 &
ws=$!

# A browser is the first thing almost every task needs. A stopped machine
# ended Chromium abruptly; mark that session as closed cleanly so it doesn't
# open with a "restore pages?" bubble.
sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/' \
  "$HOME/.config/xiryn-browser/Default/Preferences" 2>/dev/null
browser

while sleep 20; do
  for pid in "$xvfb" "$vnc" "$ws"; do
    kill -0 "$pid" 2>/dev/null || exit 1
  done

  # Someone watching the screen or a command still running counts as activity
  if [ -n "$(ss -Htn state established '( sport = :6080 or sport = :5900 )' 2>/dev/null)" ] \
    || pgrep -f '^/bin/bash /usr/local/bin/xiryn-run' >/dev/null; then
    touch "$state/active"
  fi

  # An agent clearing /tmp shouldn't take its own machine down with it
  if [ ! -e "$state/active" ] || [ ! -s "$state/vncpass" ]; then
    mkdir -p "$state"
    touch "$state/active"
    (umask 077 && echo "$vncpass" | base64 -d >"$state/vncpass")
  fi

  limit=$(cat "$state/idle-minutes" 2>/dev/null || echo 15)
  [ "$limit" -gt 0 ] 2>/dev/null || continue
  idle=$(( $(date +%s) - $(stat -c %Y "$state/active") ))
  [ "$idle" -ge $(( limit * 60 )) ] && exit 0
done
